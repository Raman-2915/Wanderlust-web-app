<% layout("/layouts/boilerplate.ejs") -%>

<style>
  .dashboard-header {
    background: linear-gradient(135deg, #f8f9fa, #fff);
    border: 1px solid #e9ecef;
    border-radius: 1rem;
    padding: 2rem;
  }

  .stat-card {
    border: 1px solid #e9ecef;
    border-radius: 0.9rem;
    padding: 1rem 1.25rem;
    height: 100%;
    background: #fff;
  }

  .stat-card .stat-number {
    font-size: 1.6rem;
    font-weight: 700;
  }

  .dashboard-section {
    margin-top: 2.5rem;
  }

  .dashboard-card {
    border: 1px solid #e9ecef;
    border-radius: 0.9rem;
    overflow: hidden;
    height: 100%;
    background: #fff;
  }

  .dashboard-card img {
    width: 100%;
    height: 12rem;
    object-fit: cover;
  }

  .dashboard-card-body {
    padding: 1rem;
  }

  .review-item {
    border: 1px solid #e9ecef;
    border-radius: 0.75rem;
    padding: 1rem;
    background: #fff;
  }
</style>

<div class="container mt-4 mb-5">
  <div class="dashboard-header">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <p class="text-muted mb-1">Your Wanderlust account</p>
        <h2 class="mb-1">Welcome, <%= user.username %>!</h2>
        <p class="text-muted mb-0"><%= user.email %></p>
      </div>
      <a href="/listings" class="btn btn-dark">Explore Listings</a>
    </div>
  </div>

  <div class="row g-3 mt-2">
    <div class="col-md-4">
      <div class="stat-card">
        <div class="text-muted">My Listings</div>
        <div class="stat-number"><%= listings.length %></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card">
        <div class="text-muted">Wishlist</div>
        <div class="stat-number"><%= favorites.length %></div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="stat-card">
        <div class="text-muted">Reviews Written</div>
        <div class="stat-number"><%= reviews.length %></div>
      </div>
    </div>
  </div>

  <section class="dashboard-section">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h3 class="mb-1">My Listings</h3>
        <p class="text-muted mb-0">Properties you have added to Wanderlust.</p>
      </div>
      <a href="/listings/new" class="btn btn-outline-dark">+ Add Listing</a>
    </div>

    <% if (listings.length === 0) { %>
      <div class="text-center border rounded-3 p-5">
        <h5>No listings yet</h5>
        <p class="text-muted">Create your first property listing to get started.</p>
        <a href="/listings/new" class="btn btn-dark">Create Listing</a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% listings.forEach(listing => { %>
          <div class="col-md-6 col-lg-4">
            <div class="dashboard-card">
              <img src="<%= listing.image?.url || '/images/default.jpg' %>" alt="<%= listing.title %>">
              <div class="dashboard-card-body">
                <h5><%= listing.title %></h5>
                <p class="text-muted mb-2"><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></p>
                <p class="mb-3">&#8377;<%= listing.price.toLocaleString("en-IN") %>/Night</p>
                <div class="d-flex gap-2">
                  <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-dark">View</a>
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-dark">Edit</a>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="dashboard-section">
    <div class="mb-3">
      <h3 class="mb-1">My Wishlist</h3>
      <p class="text-muted mb-0">Saved stays you want to come back to.</p>
    </div>

    <% if (favorites.length === 0) { %>
      <div class="text-center border rounded-3 p-5">
        <h5>Your wishlist is empty</h5>
        <p class="text-muted">Save listings you like and they will appear here.</p>
        <a href="/listings" class="btn btn-dark">Discover Places</a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% favorites.forEach(listing => { %>
          <div class="col-md-6 col-lg-4">
            <div class="dashboard-card">
              <img src="<%= listing.image?.url || '/images/default.jpg' %>" alt="<%= listing.title %>">
              <div class="dashboard-card-body">
                <h5><%= listing.title %></h5>
                <p class="text-muted mb-2"><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></p>
                <p class="mb-3">&#8377;<%= listing.price.toLocaleString("en-IN") %>/Night</p>
                <div class="d-flex gap-2">
                  <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-dark">View</a>
                  <form method="POST" action="/listings/<%= listing._id %>/favorite?_method=DELETE">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="dashboard-section">
    <div class="mb-3">
      <h3 class="mb-1">My Reviews</h3>
      <p class="text-muted mb-0">Your recent reviews across Wanderlust listings.</p>
    </div>

    <% if (reviews.length === 0) { %>
      <div class="text-center border rounded-3 p-4">
        <p class="text-muted mb-0">You have not written any reviews yet.</p>
      </div>
    <% } else { %>
      <div class="d-grid gap-3">
        <% reviews.forEach(review => { %>
          <div class="review-item">
            <div class="d-flex justify-content-between gap-3">
              <div>
                <strong><%= review.listing?.title || 'Listing' %></strong>
                <div class="text-muted small"><%= review.comment %></div>
              </div>
              <span class="badge text-bg-dark align-self-start"><%= review.rating %>/5</span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>
</div>
