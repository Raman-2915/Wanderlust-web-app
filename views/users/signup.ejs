<% layout("/layouts/boilerplate.ejs") -%>

<div class="auth-page">
  <div class="auth-shell auth-shell-reverse">
    <section class="auth-visual">
      <div class="auth-visual-content">
        <span class="auth-eyebrow">ROAMLY</span>
        <h1>Your next favourite stay starts here.</h1>
        <p>Build your collection of places, plan better trips and share stays worth discovering.</p>
      </div>
      <div class="auth-visual-note">A better way to roam.</div>
    </section>

    <section class="auth-card">
      <div class="auth-card-header">
        <span class="auth-kicker">Start exploring</span>
        <h2>Create your Roamly account</h2>
        <p>Join a community built around memorable places and easy trips.</p>
      </div>

      <form action="/signup" method="post" class="needs-validation auth-form" novalidate>
        <div class="auth-field">
          <label for="username">Username</label>
          <input type="text" name="username" id="username" placeholder="Choose a username" autocomplete="username" required />
          <div class="invalid-feedback">Please choose a username.</div>
        </div>

        <div class="auth-field">
          <label for="email">Email address</label>
          <input type="email" name="email" id="email" placeholder="you@example.com" autocomplete="email" required />
          <div class="invalid-feedback">Please enter a valid email address.</div>
        </div>

        <div class="auth-field">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" placeholder="Create a secure password" autocomplete="new-password" required />
          <div class="invalid-feedback">Please enter a password.</div>
        </div>

        <button class="auth-submit" type="submit">Create my account <i class="fa-solid fa-arrow-right"></i></button>
      </form>

      <div class="auth-switch">
        Already part of Roamly? <a href="/login">Log in</a>
      </div>
    </section>
  </div>
</div>
