<% layout("/layouts/boilerplate.ejs") -%>

<div class="listing-page">
  <section class="listing-hero">
    <span class="eyebrow">Roamly stays</span>
    <h1>Find a place worth remembering.</h1>
    <p>Search destinations, compare prices and discover your next stay.</p>

    <form class="discovery-search" action="/listings" method="GET" role="search">
      <div class="discovery-search-field">
        <i class="fa-solid fa-magnifying-glass"></i>
        <div>
          <label for="heroSearch">Where</label>
          <input id="heroSearch" name="search" value="<%= search %>" placeholder="City, country or stay" autocomplete="off" />
        </div>
      </div>
      <div class="discovery-search-field">
        <i class="fa-solid fa-location-dot"></i>
        <div>
          <label for="heroCountry">Country</label>
          <input id="heroCountry" name="country" value="<%= country %>" placeholder="Any country" autocomplete="off" />
        </div>
      </div>
      <button class="discovery-search-button" type="submit">Explore <i class="fa-solid fa-arrow-right"></i></button>
    </form>
  </section>

  <div class="filters">
    <% const categories = [["trending", "fa-fire", "Trending"], ["private-home", "fa-house", "Private homes"], ["city", "fa-city", "City stays"], ["nature", "fa-mountain-sun", "Nature"], ["waterfront", "fa-water", "By the water"], ["getaway", "fa-campground", "Getaways"]]; %>
    <% categories.forEach(([value, icon, label]) => { %>
      <a class="filter <%= category === value ? "active" : "" %>" href="/listings?category=<%= value %>"><i class="fa-solid <%= icon %>"></i><p><%= label %></p></a>
    <% }) %>
    <div class="tax-toggle">
      <div class="form-check form-switch mb-0">
        <input class="form-check-input" type="checkbox" role="switch" id="themeSwitch" aria-label="Toggle dark theme" />
        <label class="form-check-label" for="themeSwitch"><i class="fa-solid fa-circle-half-stroke me-1"></i>Dark mode</label>
      </div>
    </div>
  </div>

  <form class="listing-controls row g-3" action="/listings" method="GET">
    <% if (category) { %><input type="hidden" name="category" value="<%= category %>" /><% } %>
    <div class="col-lg-4 col-md-6">
      <label class="form-label" for="search">Search</label>
      <input class="form-control" id="search" name="search" value="<%= search %>" placeholder="Stay, city or country" />
    </div>
    <div class="col-lg-2 col-md-6">
      <label class="form-label" for="minPrice">From ₹</label>
      <input class="form-control" id="minPrice" name="minPrice" type="number" min="0" value="<%= minPrice %>" placeholder="Min" />
    </div>
    <div class="col-lg-2 col-md-6">
      <label class="form-label" for="maxPrice">To ₹</label>
      <input class="form-control" id="maxPrice" name="maxPrice" type="number" min="0" value="<%= maxPrice %>" placeholder="Max" />
    </div>
    <div class="col-lg-2 col-md-6">
      <label class="form-label" for="sort">Order</label>
      <select class="form-select" id="sort" name="sort">
        <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Recently added</option>
        <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>Oldest first</option>
        <option value="priceLow" <%= sort === "priceLow" ? "selected" : "" %>>Price: low to high</option>
        <option value="priceHigh" <%= sort === "priceHigh" ? "selected" : "" %>>Price: high to low</option>
      </select>
    </div>
    <div class="col-lg-2 d-flex align-items-end gap-2">
      <button class="btn btn-dark w-100" type="submit"><i class="fa-solid fa-sliders me-1"></i> Refine</button>
      <a class="btn btn-outline-dark" href="/listings" title="Clear all filters"><i class="fa-solid fa-rotate-left"></i></a>
    </div>
  </form>

  <% if (search || country || minPrice || maxPrice || category) { %>
    <div class="results-summary mt-4 mb-2">
      <div>
        <span class="eyebrow">Your search</span>
        <p class="mb-0"><strong><%= totalListings %></strong> stay(s) match your filters.</p>
      </div>
      <a href="/listings">Clear search</a>
    </div>
  <% } %>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mt-1">
    <% for(let listing of allListings){ %>
      <a href="/listings/<%= listing._id %>" class="listing-link">
        <article class="listing-card h-100">
          <img src="<%= listing.image?.url || '/images/default.jpg' %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy" />
          <div class="card-body">
            <div class="d-flex justify-content-between gap-2">
              <div>
                <div class="card-title"><%= listing.title %></div>
                <div class="card-location"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %></div>
              </div>
              <span class="listing-badge">Stay</span>
            </div>
            <div class="card-price">₹<%= listing.price.toLocaleString("en-IN") %> <span class="text-muted fw-normal">/ night</span></div>
          </div>
        </article>
      </a>
    <% } %>
  </div>

  <% if (allListings.length === 0) { %>
    <div class="empty-state text-center py-5 px-3 mt-4">
      <div class="empty-icon"><i class="fa-regular fa-compass"></i></div>
      <h4>No stays found</h4>
      <p class="text-muted">Try a different destination, remove a filter or widen your price range.</p>
      <a class="btn btn-dark" href="/listings">Explore every stay</a>
    </div>
  <% } %>

  <% if (totalPages > 1) { %>
    <nav aria-label="Listing pagination" class="mt-4">
      <ul class="pagination justify-content-center">
        <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>"><a class="page-link" href="/listings?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>&country=<%= encodeURIComponent(country) %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>">Previous</a></li>
        <% for(let page = 1; page <= totalPages; page++) { %>
          <li class="page-item <%= page === currentPage ? 'active' : '' %>"><a class="page-link" href="/listings?page=<%= page %>&search=<%= encodeURIComponent(search) %>&country=<%= encodeURIComponent(country) %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>"><%= page %></a></li>
        <% } %>
        <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>"><a class="page-link" href="/listings?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>&country=<%= encodeURIComponent(country) %>&category=<%= category %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>&sort=<%= sort %>">Next</a></li>
      </ul>
    </nav>
  <% } %>

  <script>
    const themeSwitch = document.getElementById("themeSwitch");
    if (themeSwitch) {
      themeSwitch.checked = document.documentElement.getAttribute("data-theme") === "dark";
      themeSwitch.addEventListener("change", () => {
        const theme = themeSwitch.checked ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", theme);
        localStorage.setItem("roamly-theme", theme);
        const navToggle = document.getElementById("themeToggle");
        if (navToggle) navToggle.innerHTML = theme === "dark" ? '<i class="fa-solid fa-sun"></i>' : '<i class="fa-solid fa-moon"></i>';
      });
    }
  </script>
</div>
