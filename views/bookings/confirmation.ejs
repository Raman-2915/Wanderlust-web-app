<% layout("/layouts/boilerplate.ejs") -%>
<div class="container py-5">
  <div class="card border-0 shadow-sm mx-auto" style="max-width: 720px;">
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="fs-1 text-success"><i class="fa-solid fa-circle-check"></i></div>
        <h2 class="mt-2">Booking Confirmed</h2>
        <p class="text-muted mb-0">Your stay has been reserved successfully.</p>
      </div>
      <h4><%= booking.listing.title %></h4>
      <p class="text-muted"><%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %></p>
      <hr>
      <div class="row g-3">
        <div class="col-md-6"><strong>Check-in</strong><br><%= booking.checkIn.toLocaleDateString("en-IN") %></div>
        <div class="col-md-6"><strong>Check-out</strong><br><%= booking.checkOut.toLocaleDateString("en-IN") %></div>
        <div class="col-md-6"><strong>Guests</strong><br><%= booking.guests %></div>
        <div class="col-md-6"><strong>Total</strong><br>&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %></div>
      </div>
      <div class="d-flex gap-2 mt-4">
        <a href="/profile" class="btn btn-dark">View My Trips</a>
        <a href="/listings" class="btn btn-outline-dark">Explore More</a>
      </div>
    </div>
  </div>
</div>
