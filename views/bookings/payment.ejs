<% layout("/layouts/boilerplate.ejs") -%>

<div class="confirmation">
  <div class="detail-panel text-center">
    <span class="eyebrow d-block mt-2">Secure checkout</span>
    <h1 class="detail-title mt-2">Complete your booking</h1>
    <p class="text-muted mb-4">Scan the demo QR below to simulate the payment step.</p>

    <div class="row justify-content-center align-items-center g-4">
      <div class="col-md-5">
        <div class="payment-qr-card p-3 border rounded-4 bg-white mx-auto">
          <img src="/images/demo-payment-qr.svg" alt="Demo payment QR code" class="img-fluid" style="max-width:260px; width:100%;" />
        </div>
        <span class="badge text-bg-light mt-3">DEMO PAYMENT • NO REAL CHARGE</span>
      </div>

      <div class="col-md-6 text-start">
        <div class="detail-panel" style="box-shadow:none; border:1px solid var(--border-color, #e5e5e5);">
          <span class="eyebrow">Booking summary</span>
          <h4 class="mt-2 mb-1"><%= booking.listing.title %></h4>
          <p class="text-muted mb-3"><%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %></p>
          <div class="d-flex justify-content-between mb-2"><span>Check-in</span><strong><%= booking.checkIn.toLocaleDateString("en-IN") %></strong></div>
          <div class="d-flex justify-content-between mb-2"><span>Check-out</span><strong><%= booking.checkOut.toLocaleDateString("en-IN") %></strong></div>
          <div class="d-flex justify-content-between mb-3"><span>Travellers</span><strong><%= booking.guests %></strong></div>
          <hr />
          <div class="d-flex justify-content-between align-items-center"><span class="fw-semibold">Amount</span><strong class="detail-price">₹<%= booking.totalPrice.toLocaleString("en-IN") %></strong></div>

          <form action="/listings/bookings/<%= booking._id %>/payment" method="POST" class="mt-4">
            <button class="btn btn-dark w-100" type="submit">
              <i class="fa-solid fa-lock me-2"></i>Simulate successful payment
            </button>
          </form>
          <p class="small text-muted text-center mt-2 mb-0">This is a portfolio/demo payment flow. No money is transferred.</p>
        </div>
      </div>
    </div>
  </div>
</div>
